[
  {
    "label": "ArkTS: Verify DevEco CLI",
    "command": "devecocli",
    "args": ["--version"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true
  },
  {
    "label": "ArkTS: Build Debug",
    "command": "devecocli",
    "args": ["build", "--build-mode", "debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true,
    "save": "all"
  },
  {
    "label": "ArkTS: Build Release",
    "command": "devecocli",
    "args": ["build", "--build-mode", "release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true,
    "save": "all"
  },
  {
    "label": "ArkTS: Build and Run",
    "command": "devecocli",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true,
    "save": "all"
  },
  {
    "label": "ArkTS: Clean",
    "command": "devecocli",
    "args": ["build", "clean"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true
  },
  {
    "label": "ArkTS: Check Lint",
    "command": "devecocli",
    "args": ["check", "lint"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true,
    "save": "all"
  },
  {
    "label": "ArkTS: List Devices",
    "command": "devecocli",
    "args": ["device", "list"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": true,
    "show_summary": true
  },
  {
    "label": "ArkTS: Device Logs",
    "command": "devecocli",
    "args": ["log"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "show_command": true,
    "show_summary": true
  }
]
